{
  "name": "kami",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Kami: a co-op adventure in a world made of paper.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "capture": "node tools/capture.mjs",
    "check:lab": "node tools/labcheck.mjs",
    "verify": "npm run typecheck && npm run test && npm run capture -- --suite smoke"
  },
  "dependencies": {
    "@fontsource/kiwi-maru": "^5.3.1",
    "@fontsource/potta-one": "^5.3.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
